# Keep secrets only in /etc/proxyfleet-xui-sync.env (mode 0600).
PROXYFLEET_OUTBOUNDS_URL=http://85.237.211.23:8788/outbounds
PROXYFLEET_OUTBOUNDS_TOKEN=

XUI_DB=/etc/x-ui/x-ui.db
XUI_SERVICE=x-ui
XUI_BALANCER_TAG=ADMOB-BALANCER

MIN_CHANGES=1
REQUIRE_READY=true
DOWNLOAD_TIMEOUT=25

# Fixed-tag endpoint changes are applied to the running Xray process without
# restarting x-ui. Leave XRAY_API_SERVER empty to discover it from config.json.
HOT_RELOAD=true
XRAY_BINARY=/usr/local/x-ui/bin/xray-linux-amd64
XRAY_RUNTIME_CONFIG=/usr/local/x-ui/bin/config.json
XRAY_API_SERVER=
XRAY_API_TIMEOUT=5

# Restart-only topology changes must remain identical for three checks and
# cannot restart x-ui more than once per 30 minutes.
RESTART_STABLE_RUNS=3
RESTART_COOLDOWN_SECONDS=1800
STATE_FILE=/var/lib/proxyfleet-xui-sync/state.json

XUI_RESTART_WAIT_SECONDS=4
BACKUP_RETENTION=10
DRY_RUN=false
